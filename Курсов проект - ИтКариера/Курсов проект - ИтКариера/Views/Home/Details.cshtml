@using System.Security.Claims;
@using Курсов_проект___ИтКариера.Data
@model Book

<style>
    .book-detail {
        max-width: 780px;
        margin: 0 auto;
    }

    .section-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #999;
        margin-bottom: 0.35rem;
    }

    .review-card {
        border: none;
        border-bottom: 1px solid #eee;
        border-radius: 0;
    }

        .review-card:last-child {
            border-bottom: none;
        }

    .badge-cat {
        font-weight: 500;
        font-size: 0.78rem;
        padding: 0.3em 0.7em;
    }

    .star-select {
        max-width: 120px;
    }
</style>

<div class="container py-5">
    <div class="book-detail">

        @if (TempData["FavoriteMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 py-2 small" role="alert">
                @TempData["FavoriteMessage"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Back link -->
        <a asp-action="Catalogue" class="text-muted text-decoration-none small d-inline-flex align-items-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
            </svg>
            Back to Catalogue
        </a>

        <!-- Title & Date -->
        <h1 class="fw-semibold mb-1" style="font-size: 1.75rem;">@Model.Title</h1>
        <p class="text-muted small mb-4">@Model.PublishedDate</p>

        <!-- Categories -->
        @if (Model.BookCategories.Any())
        {
            <div class="mb-4">
                @foreach (var category in Model.BookCategories)
                {
                    <span class="badge rounded-pill bg-light text-dark border badge-cat me-1">@category.Category.Name</span>
                }
            </div>
        }

        <!-- Description -->
        <div class="mb-4">
            <p class="section-label">Description</p>
            <p class="mb-0" style="line-height: 1.7; color: #444;">@Model.Description</p>
        </div>

        <!-- Authors -->
        <div class="mb-4">
            <p class="section-label">Authors</p>
            <p class="mb-0" style="color: #444;">
                @string.Join(", ", Model.BookAuthors.Select(a => a.User))
            </p>
        </div>

        <!-- Actions -->
        <div class="d-flex align-items-center gap-2 mb-5">
            @if (User.Identity.IsAuthenticated)
            {
                <form asp-action="ToggleFavorite" asp-controller="Home" method="post" class="d-inline">
                    <input type="hidden" name="BookId" value="@Model.Id" />
                    @if (Model.Favorites.Any(f => f.UserId == Guid.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier))))
                    {
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Remove from Favorites</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-dark btn-sm">Add to Favorites</button>
                    }
                </form>
            }

            @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Moderator")))
            {
                <form asp-action="Delete" asp-controller="Home" method="post" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this book?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete Book</button>
                </form>
            }
        </div>

        <!-- Divider -->
        <hr class="my-0 mb-4" style="border-color: #eee;" />

        <!-- Reviews Section -->
        <p class="section-label">Reviews</p>

        <!-- Review Form -->
        @if (User.Identity.IsAuthenticated)
        {
            <form asp-action="AddReview" asp-controller="Home" method="post" class="mb-4">
                <input type="hidden" name="BookId" value="@Model.Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label small text-muted mb-1">Rating</label>
                        <select name="Rating" class="form-select form-select-sm star-select" required>
                            <option value="" selected disabled></option>
                            @for (double i = 0; i <= 5; i += 0.5)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label class="form-label small text-muted mb-1">Comment</label>
                        <textarea name="Comment" class="form-control form-control-sm" rows="2" placeholder="Write your thoughts..."></textarea>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-dark btn-sm">Submit</button>
                    </div>
                </div>
            </form>
        }
        else
        {
            <p class="small text-muted mb-4">
                <a asp-controller="Account" asp-action="Login" class="text-dark">Log in</a> to write a review.
            </p>
        }

        <!-- Review List -->
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
            {
                <div class="review-card py-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fw-medium small">@review.User?.UserName</span>
                            <span class="text-muted small ms-2">@review.Rating.ToString("0.0") / 5</span>
                        </div>

                        @if (User.Identity.IsAuthenticated &&
                       (review.UserId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                       || User.IsInRole("Admin")
                       || User.IsInRole("Moderator")))
                        {
                            <form asp-action="DeleteReview" asp-controller="Home" method="post" class="d-inline">
                                <input type="hidden" name="reviewId" value="@review.Id" />
                                <input type="hidden" name="bookId" value="@Model.Id" />
                                <button type="submit"
                                        class="btn btn-link btn-sm text-muted p-0"
                                        style="font-size: 0.75rem;"
                                        onclick="return confirm('Are you sure you want to delete this review?');">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                    <p class="mb-0 mt-1 small" style="color: #555;">@review.Comment</p>
                </div>
            }
        }
        else
        {
            <p class="small text-muted">No reviews yet.</p>
        }

    </div>
</div>
