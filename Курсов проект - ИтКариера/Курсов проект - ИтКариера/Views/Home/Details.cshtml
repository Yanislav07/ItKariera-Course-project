@using System.Security.Claims;
@using Курсов_проект___ИтКариера.Data
@model Book
@{
    ViewData["Title"] = Model.Title;
    var userId = User.Identity.IsAuthenticated
        ? Guid.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier))
        : Guid.Empty;
    var isFavorite = Model.Favorites.Any(f => f.UserId == userId);
    var avgRating = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating).ToString("0.0")
        : "—";
    var reviewCount = Model.Reviews?.Count() ?? 0;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500&display=swap');

    :root {
        --bg:           #F8F3EE;
        --bg-alt:       #EFE6DB;
        --surface:      #F2EBE2;
        --border:       #D4C4B5;
        --border-dark:  #B8A898;
        --primary:      #6B3F22;
        --text:         #1C0F07;
        --text-2:       #5A3D28;
        --text-3:       #9C8070;
        --white:        #FFFCF9;
        --danger:       #A63020;
        --shadow-sm:    0 1px 4px rgba(80,40,10,0.07);
        --shadow-md:    0 6px 24px rgba(80,40,10,0.11);
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body:    'Jost', sans-serif;
        --r:            5px;
        --tr:           0.2s ease;
    }

    body {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
    }

    /* ── Back link ───────────────────────────────── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.8rem;
        color: var(--text-3);
        text-decoration: none;
        margin-bottom: 2rem;
        letter-spacing: 0.03em;
        transition: color var(--tr);
    }
    .back-link:hover { color: var(--text); }

    /* ── Page title ──────────────────────────────── */
    .book-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 600;
        color: var(--text);
        line-height: 1.1;
        margin: 0 0 0.3rem;
        border-bottom: 2px solid var(--border-dark);
        padding-bottom: 0.6rem;
    }
    .book-subtitle-line {
        font-size: 0.85rem;
        color: var(--text-3);
        margin: 0.4rem 0 2rem;
        font-style: italic;
    }

    /* ── Two-column layout ───────────────────────── */
    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 3rem;
        align-items: start;
    }
    @@media (max-width: 767px) {
        .detail-grid { grid-template-columns: 1fr; }
        .detail-sidebar { order: -1; }
    }

    /* ── Main column ─────────────────────────────── */
    .detail-main {}

    .sec-heading {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--text);
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.35rem;
        margin: 2rem 0 0.85rem;
    }
    .sec-heading:first-of-type { margin-top: 0; }

    .detail-body {
        font-size: 0.97rem;
        line-height: 1.82;
        color: var(--text-2);
        margin: 0;
    }

    /* ── Sidebar info box ────────────────────────── */
    .detail-sidebar {}

    .info-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-top: 3px solid var(--border-dark);
        border-radius: var(--r);
        overflow: hidden;
        font-size: 0.88rem;
    }

    .info-box-title {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text);
        background: var(--bg-alt);
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border);
        margin: 0;
        text-align: center;
    }

    .info-row {
        display: flex;
        border-bottom: 1px solid var(--border);
        padding: 0;
    }
    .info-row:last-child { border-bottom: none; }

    .info-key {
        background: var(--bg-alt);
        color: var(--text-3);
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 0.65rem 0.85rem;
        min-width: 110px;
        border-right: 1px solid var(--border);
        display: flex;
        align-items: center;
    }

    .info-val {
        padding: 0.65rem 0.85rem;
        color: var(--text-2);
        font-size: 0.88rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .cat-pill {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 500;
        padding: 0.2em 0.65em;
        border-radius: 99px;
        border: 1px solid var(--border-dark);
        background: var(--white);
        color: var(--text-2);
    }

    /* ── Action buttons in sidebar ───────────────── */
    .sidebar-actions {
        padding: 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        border-top: 1px solid var(--border);
    }

    .btn-fav-add {
        font-family: var(--font-body);
        font-size: 0.84rem;
        font-weight: 500;
        padding: 0.55rem 1rem;
        background: var(--text);
        color: var(--white);
        border: none;
        border-radius: var(--r);
        cursor: pointer;
        width: 100%;
        text-align: center;
        transition: background var(--tr);
    }
    .btn-fav-add:hover { background: var(--primary); }

    .btn-fav-remove {
        font-family: var(--font-body);
        font-size: 0.84rem;
        font-weight: 500;
        padding: 0.55rem 1rem;
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--r);
        cursor: pointer;
        width: 100%;
        text-align: center;
        transition: border-color var(--tr), background var(--tr);
    }
    .btn-fav-remove:hover { border-color: var(--text); background: var(--bg-alt); }

    .btn-delete {
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 400;
        padding: 0.45rem 1rem;
        background: transparent;
        color: var(--danger);
        border: 1px solid #d9b0aa;
        border-radius: var(--r);
        cursor: pointer;
        width: 100%;
        transition: background var(--tr), color var(--tr);
    }
    .btn-delete:hover { background: var(--danger); color: var(--white); border-color: var(--danger); }

    /* ── Alert ───────────────────────────────────── */
    .fav-alert {
        background: var(--bg-alt);
        border: 1px solid var(--border);
        border-left: 3px solid var(--primary);
        color: var(--text-2);
        border-radius: var(--r);
        font-size: 0.88rem;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .fav-alert button {
        background: none; border: none; color: var(--text-3);
        cursor: pointer; font-size: 1rem; padding: 0;
    }
    .fav-alert button:hover { color: var(--text); }

    /* ── Reviews ─────────────────────────────────── */
    .review-form-wrap {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow-sm);
    }
    .review-form-wrap .form-label {
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 0.3rem;
        display: block;
    }
    .review-form-wrap .form-control,
    .review-form-wrap .form-select {
        font-family: var(--font-body);
        font-size: 0.9rem;
        background: var(--bg-alt);
        border: 1px solid var(--border);
        border-radius: var(--r);
        color: var(--text);
        padding: 0.5rem 0.75rem;
    }
    .review-form-wrap .form-control:focus,
    .review-form-wrap .form-select:focus {
        border-color: var(--text);
        box-shadow: 0 0 0 3px rgba(28,15,7,0.07);
        background: var(--white);
        outline: none;
        color: var(--text);
    }
    .review-form-wrap .form-control::placeholder { color: var(--text-3); }
    .btn-submit {
        font-family: var(--font-body);
        font-size: 0.84rem;
        font-weight: 500;
        padding: 0.5rem 1.3rem;
        background: var(--text);
        color: var(--white);
        border: none;
        border-radius: var(--r);
        cursor: pointer;
        transition: background var(--tr);
    }
    .btn-submit:hover { background: var(--primary); }

    .review-item {
        padding: 1rem 0;
        border-bottom: 1px solid var(--border);
    }
    .review-item:last-child { border-bottom: none; }

    .review-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.35rem;
    }
    .review-meta {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
    }
    .review-user {
        font-weight: 500;
        font-size: 0.9rem;
        color: var(--text);
    }
    .review-stars {
        font-size: 0.82rem;
        color: var(--text-3);
    }
    .review-comment {
        font-size: 0.92rem;
        color: var(--text-2);
        line-height: 1.65;
        margin: 0;
    }
    .btn-review-delete {
        font-size: 0.75rem;
        color: var(--text-3);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: color var(--tr);
        text-decoration: none;
    }
    .btn-review-delete:hover { color: var(--danger); }

    .review-empty {
        font-size: 0.9rem;
        color: var(--text-3);
        font-style: italic;
        padding: 1rem 0;
    }
    .login-prompt {
        font-size: 0.88rem;
        color: var(--text-3);
        padding: 0.75rem 0 1.5rem;
    }
    .login-prompt a {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 2px;
    }
</style>

<div style="padding: 2.5rem 0 5rem;">

    @if (TempData["FavoriteMessage"] != null)
    {
        <div class="fav-alert">
            <span>@TempData["FavoriteMessage"]</span>
            <button onclick="this.parentElement.remove()">&#x2715;</button>
        </div>
    }

    @if (TempData["ListMessage"] != null)
    {
        <div class="fav-alert">
            <span>@TempData["ListMessage"]</span>
            <button onclick="this.parentElement.remove()">&#x2715;</button>
        </div>
    }

    <!-- Back -->
    <a asp-action="Catalogue" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Back to Catalogue
    </a>

    <!-- Title -->
    <h1 class="book-title">@Model.Title</h1>
    <p class="book-subtitle-line">
        Published @Model.PublishedDate
        @if (!string.IsNullOrEmpty(Model.AuthorName))
        {
            <text> &mdash; @Model.AuthorName</text>
        }
    </p>

    <!-- Two-column grid -->
    <div class="detail-grid">

        <!-- LEFT: main content -->
        <div class="detail-main">

            <h2 class="sec-heading">Description</h2>
            <p class="detail-body">@Model.Description</p>

            @if (!string.IsNullOrEmpty(Model.AuthorName))
            {
                <h2 class="sec-heading">Author</h2>
                <p class="detail-body">@Model.AuthorName</p>
            }

            <!-- Reviews -->
            <h2 class="sec-heading">
                Reviews
                @if (reviewCount > 0)
                {
                    <span style="font-family: var(--font-body); font-size: 0.82rem; font-weight: 400; color: var(--text-3); margin-left: 0.5rem;">@reviewCount review@(reviewCount == 1 ? "" : "s") &middot; avg @avgRating / 5</span>
                }
            </h2>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="review-form-wrap">
                    <form asp-action="AddReview" asp-controller="Home" method="post">
                        <input type="hidden" name="BookId" value="@Model.Id" />
                        <div class="row g-3 align-items-end">
                            <div class="col-auto">
                                <label class="form-label">Rating</label>
                                <select name="Rating" class="form-select" style="width: 100px;" required>
                                    <option value="" selected disabled>—</option>
                                    @for (double i = 0.5; i <= 5; i += 0.5)
                                    {
                                        <option value="@i">@i ★</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label class="form-label">Your Review</label>
                                <textarea name="Comment" class="form-control" rows="2" placeholder="Share your thoughts on this book..."></textarea>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn-submit">Post</button>
                            </div>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <p class="login-prompt">
                    <a asp-area="Identity" asp-page="/Account/Login">Log in</a> to write a review.
                </p>
            }

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div>
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="review-item">
                            <div class="review-top">
                                <div class="review-meta">
                                    <span class="review-user">@review.User?.UserName</span>
                                    <span class="review-stars">@review.Rating.ToString("0.0") / 5.0 ★</span>
                                </div>
                                @if (User.Identity.IsAuthenticated &&
                                    (review.UserId == userId || User.IsInRole("Admin") || User.IsInRole("Moderator")))
                                {
                                    <form asp-action="DeleteReview" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="reviewId" value="@review.Id" />
                                        <input type="hidden" name="bookId" value="@Model.Id" />
                                        <button type="submit" class="btn-review-delete"
                                                onclick="return confirm('Delete this review?');">Delete</button>
                                    </form>
                                }
                            </div>
                            <p class="review-comment">@review.Comment</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="review-empty">No reviews yet — be the first to share your thoughts.</p>
            }

        </div>

        <!-- RIGHT: sidebar -->
        <div class="detail-sidebar">
            <div class="info-box">
                <p class="info-box-title">Book Information</p>

                <div class="info-row">
                    <span class="info-key">Published</span>
                    <span class="info-val">@Model.PublishedDate</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.AuthorName))
                {
                    <div class="info-row">
                        <span class="info-key">Author</span>
                        <span class="info-val">@Model.AuthorName</span>
                    </div>
                }

                @if (Model.BookCategories != null && Model.BookCategories.Any())
                {
                    <div class="info-row">
                        <span class="info-key">Genre</span>
                        <span class="info-val">
                            @foreach (var cat in Model.BookCategories)
                            {
                                <span class="cat-pill">@cat.Category.Name</span>
                            }
                        </span>
                    </div>
                }

                <div class="info-row">
                    <span class="info-key">Rating</span>
                    <span class="info-val">
                        @if (reviewCount > 0)
                        {
                            <text>@avgRating / 5 &nbsp;<span style="color:var(--text-3); font-size:0.8rem;">(@reviewCount reviews)</span></text>
                        }
                        else
                        {
                            <text>No ratings yet</text>
                        }
                    </span>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="sidebar-actions">
                        <form asp-action="ToggleFavorite" asp-controller="Home" method="post">
                            <input type="hidden" name="BookId" value="@Model.Id" />
                            @if (isFavorite)
                            {
                                <button type="submit" class="btn-fav-remove">&#9829; Remove from Favorites</button>
                            }
                            else
                            {
                                <button type="submit" class="btn-fav-add">&#9825; Add to Favorites</button>
                            }
                        </form>

                        <hr style="border:none;border-top:1px solid var(--border);margin:0.5rem 0;" />

                        <!-- Create new list -->
                        <form asp-action="CreateList" asp-controller="Home" method="post">
                            <input type="hidden" name="bookId" value="@Model.Id" />
                            <input type="text" name="name"
                                   placeholder="New list..."
                                   style="width:100%;padding:0.45rem 0.6rem;margin-bottom:0.4rem;
                      border:1px solid var(--border);border-radius:var(--r);
                      font-size:0.8rem;background:var(--bg-alt);" required />
                            <button type="submit" class="btn-fav-add">+ Create List</button>
                        </form>

                        <!-- Add to existing list -->
                        @if (ViewBag.UserLists != null && ((List<ReadingList>)ViewBag.UserLists).Any())
                        {
                            <form asp-action="AddToList" asp-controller="Home" method="post" style="margin-top:0.4rem;">
                                <input type="hidden" name="bookId" value="@Model.Id" />

                                <select name="listId"
                                        style="width:100%;padding:0.45rem 0.6rem;margin-bottom:0.4rem;
                               border:1px solid var(--border);border-radius:var(--r);
                               font-size:0.8rem;background:var(--bg-alt);">
                                    @foreach (var list in (List<ReadingList>)ViewBag.UserLists)
                                    {
                                        <option value="@list.Id">@list.Name</option>
                                    }
                                </select>

                                <button type="submit" class="btn-fav-remove">Add to List</button>
                            </form>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                        {
                            <form asp-action="Delete" asp-controller="Home" method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this book?');">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn-delete">Delete Book</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</div>
