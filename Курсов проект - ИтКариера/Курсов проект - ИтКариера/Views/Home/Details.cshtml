@using Курсов_проект___ИтКариера.Data
@model Book

<div class="container py-4">
    <h1 class="fw-bold">@Model.Title</h1>

    <p class="text-muted">
        Published: @Model.PublishedDate.ToString()
    </p>

    <hr />

    <h4>Description</h4>
    <p>@Model.Description</p>

    <hr />

    <h4>Authors</h4>
    <ul>
        @foreach (var author in Model.BookAuthors)
        {
            <li>@author.User</li>
        }
    </ul>

    <hr />

    <h4>Categories</h4>
    <ul>
        @foreach (var category in Model.BookCategories)
        {
            <li>@category.Category.Name</li>
        }
    </ul>

    <hr />

    <h4>Reviews</h4>
    @if (Model.Reviews.Any())
    {
        @foreach (var review in Model.Reviews)
        {
            <div class="border p-2 mb-2">
                <strong>@review.User.UserName</strong>
                <p>@review.Comment</p>
            </div>
        }
    }
    else
    {
        <p>No reviews yet.</p>
    }

    @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Moderator")))
    {
        <form asp-action="Delete" asp-controller="Home" method="post" onsubmit="return confirm('Are you sure you want to delete this book?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger mt-3">Delete Book</button>
        </form>
    }


    <a asp-action="Catalogue" class="btn btn-secondary mt-3">Back to Catalogue</a>
</div>
