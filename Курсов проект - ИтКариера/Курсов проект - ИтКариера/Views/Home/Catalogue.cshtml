@using Курсов_проект___ИтКариера.Data
@model IEnumerable<Book>
@{
    ViewData["Title"] = "Catalogue";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Jost:wght@300;400;500&display=swap');

    :root {
        --bg: #F8F3EE;
        --bg-alt: #EFE6DB;
        --border: #D4C4B5;
        --primary: #6B3F22;
        --text: #1C0F07;
        --text-2: #5A3D28;
        --text-3: #9C8070;
        --white: #FFFCF9;
        --shadow-sm: 0 1px 6px rgba(80,40,10,0.07);
        --shadow-md: 0 8px 32px rgba(80,40,10,0.13);
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body: 'Jost', sans-serif;
        --r: 6px;
        --tr: 0.22s cubic-bezier(.4,0,.2,1);
    }

    body {
        font-family: var(--font-body);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
    }

    /* ── Page header ─────────────────────────────── */
    .cat-header {
        padding: 3rem 0 2rem;
    }

    .cat-eyebrow {
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-3);
        margin: 0 0 0.4rem;
    }

    .cat-title {
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        font-weight: 600;
        color: var(--text);
        margin: 0 0 0.5rem;
        line-height: 1.1;
    }

    .cat-subtitle {
        font-size: 0.97rem;
        color: var(--text-2);
        margin: 0;
    }

    /* ── Add book button ─────────────────────────── */
    .btn-add {
        font-family: var(--font-body);
        font-size: 0.86rem;
        font-weight: 500;
        padding: 0.55rem 1.2rem;
        background: var(--text);
        color: var(--white);
        border: none;
        border-radius: var(--r);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: background var(--tr), transform var(--tr);
        white-space: nowrap;
    }

        .btn-add:hover {
            background: var(--primary);
            color: var(--white);
            transform: translateY(-1px);
        }

    /* ── Divider ─────────────────────────────────── */
    .cat-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0 0 2rem;
    }

    /* ── Book cards ──────────────────────────────── */
    .book-card {
        background: var(--white);
        border: 1px solid var(--border) !important;
        border-radius: var(--r) !important;
        box-shadow: var(--shadow-sm) !important;
        transition: box-shadow var(--tr), transform var(--tr);
        overflow: hidden;
    }

        .book-card:hover {
            box-shadow: var(--shadow-md) !important;
            transform: translateY(-3px);
        }

        .book-card .card-body {
            padding: 1.25rem 1.25rem 0.75rem;
        }

    .book-card-title {
        font-family: var(--font-display);
        font-size: 1.08rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.5rem;
    }

    .book-card-text {
        font-size: 0.9rem;
        color: var(--text-2);
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .book-card .card-footer {
        background: var(--bg-alt) !important;
        border-top: 1px solid var(--border) !important;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .book-card-date {
        font-size: 0.78rem;
        color: var(--text-3);
    }

    .btn-card {
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 500;
        padding: 0.32rem 0.85rem;
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--r);
        text-decoration: none;
        transition: background var(--tr), color var(--tr), border-color var(--tr);
    }

        .btn-card:hover {
            background: var(--text);
            color: var(--white);
            border-color: var(--text);
        }

    /* ── Success alert ───────────────────────────── */
    .alert-success {
        background: var(--bg-alt);
        border: 1px solid var(--border);
        border-left: 3px solid var(--primary);
        color: var(--text-2);
        border-radius: var(--r);
        font-size: 0.92rem;
        padding: 0.85rem 1.1rem;
        margin-bottom: 1.5rem;
    }

    /* ── Empty state ─────────────────────────────── */
    .empty-state {
        text-align: center;
        padding: 5rem 0;
        color: var(--text-3);
        font-size: 0.95rem;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">@TempData["SuccessMessage"]</div>
}

<!-- ── Page Header ────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-start cat-header">
    <div>
        <p class="cat-eyebrow">Explore</p>
        <h1 class="cat-title">Catalogue</h1>
        <p class="cat-subtitle">Browse our collection of @Model.Count() titles across every genre.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Moderator") || User.IsInRole("Author"))
    {
        <a asp-action="AddNewBook" asp-controller="Moderator" class="btn-add mt-3">
            + Add New Book
        </a>
    }
</div>

<hr class="cat-divider" />

<!-- ── Book Grid ─────────────────────────────────────────── -->
@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var book in Model)
        {
            <div class="col">
                <div class="card book-card h-100">
                    <div class="card-body">
                        <h5 class="book-card-title">@book.Title</h5>
                        <p class="book-card-text">@book.Description</p>
                    </div>
                    <div class="card-footer">
                        <span class="book-card-date">Published: @book.PublishedDate</span>
                        <a asp-action="Details" asp-route-id="@book.Id" class="btn-card">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <p>No books found in the library yet.</p>
    </div>
}
