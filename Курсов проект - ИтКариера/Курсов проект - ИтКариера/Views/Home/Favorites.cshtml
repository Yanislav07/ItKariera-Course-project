@using Курсов_проект___ИтКариера.Data
@model IEnumerable<Book>
@{
    ViewData["Title"] = "Favorites";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Jost:wght@300;400;500&display=swap');

    :root {
        --bg: #F8F3EE;
        --bg-alt: #EFE6DB;
        --border: #D4C4B5;
        --primary: #6B3F22;
        --text: #1C0F07;
        --text-2: #5A3D28;
        --text-3: #9C8070;
        --white: #FFFCF9;
        --shadow-sm: 0 1px 6px rgba(80,40,10,0.07);
        --shadow-md: 0 8px 32px rgba(80,40,10,0.13);
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body: 'Jost', sans-serif;
        --r: 6px;
        --tr: 0.22s cubic-bezier(.4,0,.2,1);
    }

    body {
        font-family: var(--font-body);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
    }

    /* ── Page header ─────────────────────────────── */
    .fav-header {
        padding: 3rem 0 2rem;
    }

    .fav-eyebrow {
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-3);
        margin: 0 0 0.4rem;
    }

    .fav-title {
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        font-weight: 600;
        color: var(--text);
        margin: 0 0 0.5rem;
        line-height: 1.1;
    }

    .fav-subtitle {
        font-size: 0.97rem;
        color: var(--text-2);
        margin: 0;
    }

    .fav-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0 0 2rem;
    }

    /* ── List rows ───────────────────────────────── */
    .fav-list {
        display: flex;
        flex-direction: column;
    }

    .fav-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--border);
        transition: background var(--tr);
    }

        .fav-item:first-child {
            border-top: 1px solid var(--border);
        }

    .fav-item-number {
        font-family: var(--font-display);
        font-size: 1rem;
        color: var(--text-3);
        min-width: 24px;
        text-align: right;
        font-style: italic;
    }

    .fav-item-body {
        flex: 1;
    }

    .fav-item-title {
        font-family: var(--font-display);
        font-size: 1.08rem;
        font-weight: 600;
        color: var(--text);
        margin: 0 0 0.3rem;
    }

    .fav-item-desc {
        font-size: 0.88rem;
        color: var(--text-3);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.55;
    }

    /* View button */
    .btn-fav {
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 500;
        padding: 0.35rem 0.95rem;
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--r);
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background var(--tr), color var(--tr), border-color var(--tr);
    }

        .btn-fav:hover {
            background: var(--text);
            color: var(--white);
            border-color: var(--text);
        }

    /* ── Empty state ─────────────────────────────── */
    .empty-state {
        text-align: center;
        padding: 5rem 0;
    }

    .empty-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        opacity: 0.35;
    }

    .empty-title {
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.5rem;
    }

    .empty-sub {
        font-size: 0.92rem;
        color: var(--text-3);
        margin-bottom: 1.5rem;
    }

    .btn-empty {
        font-family: var(--font-body);
        font-size: 0.88rem;
        font-weight: 500;
        padding: 0.65rem 1.4rem;
        background: var(--text);
        color: var(--white);
        border: none;
        border-radius: var(--r);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: background var(--tr), transform var(--tr);
    }

        .btn-empty:hover {
            background: var(--primary);
            color: var(--white);
            transform: translateY(-1px);
        }
</style>

<!-- ── Page Header ──────────────────────────────────────── -->
<div class="fav-header">
    <p class="fav-eyebrow">Your Collection</p>
    <h1 class="fav-title">Favorites</h1>
    <p class="fav-subtitle">
        @if (Model.Any())
        {
            <text>@Model.Count() book@(Model.Count() == 1 ? "" : "s") saved to your list</text>
        }
        else
        {
            <text>Books you save will appear here</text>
        }
    </p>
</div>

<hr class="fav-divider" />

<!-- ── List / Empty ─────────────────────────────────────── -->
@if (Model.Any())
{
    <div class="fav-list">
        @{
            int i = 1;
        }
        @foreach (var book in Model)
        {
            <div class="fav-item">
                <span class="fav-item-number">@i</span>
                <div class="fav-item-body">
                    <p class="fav-item-title">@book.Title</p>
                    <p class="fav-item-desc">@book.Description</p>
                </div>
                <a asp-action="Details" asp-route-id="@book.Id" class="btn-fav">View</a>
            </div>
            i++;
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-icon">♡</div>
        <p class="empty-title">No favorites yet</p>
        <p class="empty-sub">Browse the catalogue and save books you love.</p>
        <a asp-area="" asp-controller="Home" asp-action="Catalogue" class="btn-empty">
            Browse Catalogue &rarr;
        </a>
    </div>
}
