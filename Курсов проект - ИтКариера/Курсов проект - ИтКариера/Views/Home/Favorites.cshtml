@using Курсов_проект___ИтКариера.Data
@model IEnumerable<Book>

<div class="container py-4" style="max-width: 800px;">

    <h1 class="fw-normal mb-4">Your Favorite Books</h1>
    <hr />

    @if (!Model.Any())
    {
        <p class="text-muted">You haven't added any favorites yet.</p>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var book in Model)
            {
                <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start border-bottom border-top-0 border-start-0 border-end-0 bg-transparent">
                    <div class="me-3">
                        <span class="fw-medium">@book.Title</span>
                        <p class="text-muted small mb-0 mt-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @book.Description
                        </p>
                    </div>
                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-secondary btn-sm flex-shrink-0 align-self-center">View</a>
                </div>
            }
        </div>
    }
</div>
