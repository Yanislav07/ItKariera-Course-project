@model BookViewModel

@{
    ViewData["Title"] = "Add New Book";
}

<div class="container py-4" style="max-width: 860px;">

    <div class="mb-4">
        <h1 class="h4 fw-semibold text-dark mb-1">Add New Book</h1>
        <p class="text-muted small mb-0">Fill in the details below to add a book to the catalogue.</p>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post" asp-action="Create" asp-controller="Moderator">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Book.Title" class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.03em;">
                        Title
                    </label>
                    <input asp-for="Book.Title"
                           class="form-control"
                           placeholder="Enter the book title"
                           aria-required="true" />
                    <span asp-validation-for="Book.Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Book.Description" class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.03em;">
                        Description
                    </label>
                    <textarea asp-for="Book.Description"
                              class="form-control"
                              rows="5"
                              placeholder="Write a brief description of the book"
                              aria-required="true"></textarea>
                    <span asp-validation-for="Book.Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Book.PublishedDate" class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.03em;">
                        Publish Date
                    </label>
                    <input asp-for="Book.PublishedDate"
                           type="date"
                           class="form-control"
                           style="max-width: 220px;"
                           aria-required="true" />
                    <span asp-validation-for="Book.PublishedDate" class="text-danger small"></span>
                </div>

                <div class="border-top pt-3 d-flex justify-content-end gap-2">
                    <a asp-page="/Index" class="btn btn-sm btn-light px-3">Cancel</a>
                    <button type="submit" class="btn btn-sm btn-dark px-4">
                        Add Book
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
