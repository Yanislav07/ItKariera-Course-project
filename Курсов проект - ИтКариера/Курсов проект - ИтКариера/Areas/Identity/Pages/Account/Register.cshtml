@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <h2 class="fw-semibold mb-1 text-center">Create account</h2>
                <p class="text-muted text-center mb-4">Join BookTalk today</p>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" placeholder="password" />
                        <label asp-for="Input.Password">Password</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 mb-3">
                        Register
                    </button>

                    <div class="text-center">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-page="./Login" class="text-decoration-none fw-semibold">
                            Log in
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}